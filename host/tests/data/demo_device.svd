<?xml version="1.0" encoding="utf-8"?>
<!-- The register map of the stub device behind the bus explorer's target port
     in gateware/example/bus_explorer/tb.vhd, as an SVD document.

     It is deliberately written in more than one style, because a decoder is
     only worth what it reads: the three bit-range spellings SVD allows all
     appear here (bitOffset/bitWidth on CTRL.ENABLE, bitRange on CTRL.MODE,
     msb/lsb on CTRL.GAIN), the access attribute distinguishes the read-only
     registers from the read/write ones, and one field carries enumerated
     values. -->
<device schemaVersion="1.3" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance">
  <name>GATECAP_DEMO_DEVICE</name>
  <description>Stub device the gatecap bus-explorer example explores</description>
  <addressUnitBits>8</addressUnitBits>
  <width>32</width>
  <size>32</size>
  <access>read-write</access>
  <peripherals>
    <peripheral>
      <name>DEMO</name>
      <description>The whole device: one peripheral at address zero</description>
      <baseAddress>0x00000000</baseAddress>
      <registers>

        <register>
          <name>ID</name>
          <description>Constant identifier</description>
          <addressOffset>0x000</addressOffset>
          <access>read-only</access>
          <resetValue>0x5CA1AB1E</resetValue>
        </register>

        <register>
          <name>CTRL</name>
          <description>What the host drives</description>
          <addressOffset>0x004</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>ENABLE</name>
              <description>Master enable</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>MODE</name>
              <description>What the device does when enabled</description>
              <bitRange>[2:1]</bitRange>
              <enumeratedValues>
                <enumeratedValue>
                  <name>IDLE</name>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RUN</name>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TEST</name>
                  <value>2</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>GAIN</name>
              <description>Echoed into STATUS.GAIN</description>
              <lsb>4</lsb>
              <msb>11</msb>
            </field>
          </fields>
        </register>

        <register>
          <name>STATUS</name>
          <description>What the device makes of CTRL</description>
          <addressOffset>0x008</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>ENABLED</name>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>MODE</name>
              <bitOffset>1</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>RUNNING</name>
              <description>Enabled and in RUN mode</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>GAIN</name>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>

        <register>
          <name>SCRATCH</name>
          <description>A plain word, mirrored inverted into MIRROR</description>
          <addressOffset>0x00C</addressOffset>
          <access>read-write</access>
        </register>

        <register>
          <name>MIRROR</name>
          <description>SCRATCH, inverted</description>
          <addressOffset>0x010</addressOffset>
          <access>read-only</access>
        </register>

        <register>
          <name>FAULT</name>
          <description>Always answers pslverr</description>
          <addressOffset>0x020</addressOffset>
          <access>read-write</access>
        </register>

        <register>
          <name>SLOW</name>
          <description>Answers long after the engine has given up</description>
          <addressOffset>0x024</addressOffset>
          <access>read-only</access>
        </register>

      </registers>
    </peripheral>
  </peripherals>
</device>
