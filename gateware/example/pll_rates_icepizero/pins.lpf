SYSCONFIG CONFIG_IOVOLTAGE=3.3 COMPRESS_CONFIG=ON MCCLK_FREQ=62 MASTER_SPI_PORT=DISABLE SLAVE_SPI_PORT=DISABLE SLAVE_PARALLEL_PORT=DISABLE;

BLOCK RESETPATHS;
BLOCK ASYNCPATHS;

LOCATE COMP "uart_rx_i" SITE "K16";
IOBUF  PORT "uart_rx_i" IO_TYPE=LVCMOS33 PULLMODE=UP DRIVE=4;
LOCATE COMP "uart_tx_o" SITE "K15";
IOBUF  PORT "uart_tx_o" IO_TYPE=LVCMOS33 PULLMODE=UP DRIVE=4;

LOCATE COMP "global_clk_i" SITE "M1";
IOBUF  PORT "global_clk_i" IO_TYPE=LVCMOS33 PULLMODE=NONE;
FREQUENCY PORT "global_clk_i" 50 MHZ;

LOCATE COMP "led_o" SITE "D14";
IOBUF  PORT "led_o" IO_TYPE=LVCMOS33 PULLMODE=DOWN DRIVE=4;
